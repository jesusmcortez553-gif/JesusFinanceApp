rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario autenticado accede SOLO a su subcoleccion users/{uid}/...
    // Esta es la garantia de sesiones individuales de Pronto App.
    // IMPORTANTE: este archivo es documentacion versionada. Las reglas activas
    // se publican en Firebase Console -> Firestore -> Reglas (o via firebase deploy).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
